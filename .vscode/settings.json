{
  "godotTools.editorPath.godot4": "godot4",
  "files.watcherExclude": {
    "**/.godot/**": true
  },
  "search.exclude": {
    "**/.godot": true
  },
  "files.associations": {
    "*.gd": "gdscript",
    "*.tscn": "gdresource"
  },
  "[gdscript]": {
    "editor.defaultFormatter": "gdformat",
    "editor.formatOnSave": false
  }
}
