#!/usr/bin/env bash
# Run codecheck before commits on protected primary branches.
set -euo pipefail

BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
if [[ "$BRANCH" != "main" && "$BRANCH" != "master" ]]; then
	exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "pre-commit: running codecheck on $BRANCH..."

if [[ -f "$ROOT/tools/codecheck.sh" ]]; then
	bash "$ROOT/tools/codecheck.sh"
elif [[ -f "$ROOT/tools/codecheck.ps1" ]]; then
	powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$ROOT/tools/codecheck.ps1"
else
	echo "pre-commit: codecheck script not found" >&2
	exit 1
fi
